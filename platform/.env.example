# Скопируйте в .env и заполните.
# Секрет для cookie и шифрования токенов. Сгенерируйте свой:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# mock — демо без затрат; dsh — реальный агент через DeepSeek Harness.
AGENT_MODE=dsh
DSH_HOME=/data/dsh

# Нужен только для AGENT_MODE=dsh. Не коммитьте.
DEEPSEEK_API_KEY=

# Токенная модель: стартовый баланс нового ученика.
START_TOKENS=1000000
# Демо-начисление пакетов без оплаты. В проде выключить.
DEMO_TOPUP=1

# Розничная цена токена: 0.00039 ₽ = 390 ₽ за 1 млн.
SELL_PRICE_PER_TOKEN=0.00039

# Ориентир себестоимости токена (DeepSeek flash, микс input/output).
TOKEN_COST_PER_TOKEN=0.00015

# Себестоимость по типам токенов — для аналитики.
COST_IN_PER_TOKEN=0.000015
COST_OUT_PER_TOKEN=0.000060

# Путь к dsh, если он не в PATH.
DSH_BIN=dsh

# Публичный адрес (для будущих webhook/деплоя).
PUBLIC_URL=http://127.0.0.1:8000

# Если задан пароль — весь сайт закрыт HTTP Basic Auth (для публичного демо).
DEMO_USER=demo
DEMO_PASSWORD=
